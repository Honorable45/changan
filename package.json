{
  "name": "changan-togo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "db:start": "bash scripts/db-local.sh start",
    "db:stop": "bash scripts/db-local.sh stop",
    "db:migrate": "pnpm --filter backend prisma migrate deploy",
    "db:seed": "pnpm --filter backend seed",
    "admin:create": "pnpm --filter backend admin:create",
    "dev": "pnpm --parallel --filter backend --filter frontend --filter admin dev",
    "build": "pnpm --filter backend build && pnpm --filter frontend --filter admin --filter jeu-client build",
    "start": "pnpm --parallel --filter backend --filter frontend --filter admin --filter jeu-client --filter jeu-serveur start",
    "test:e2e": "node --test e2e/*.test.mjs jeu/tests/*.test.mjs",
    "jeu:dev": "pnpm --parallel --filter jeu-client --filter jeu-serveur dev",
    "jeu:build": "pnpm --filter jeu-client build",
    "jeu:start": "pnpm --parallel --filter jeu-client --filter jeu-serveur start",
    "jeu:charge": "pnpm --filter jeu-serveur charge",
    "test:jeu": "node --test jeu/tests/*.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  },
  "pnpm": {
    "overrides": {
      "multer": ">=2.5.0",
      "postcss": ">=8.5.23",
      "js-yaml": ">=5.4.1"
    }
  }
}
