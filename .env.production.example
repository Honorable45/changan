# Copier vers .env.production (jamais versionné) puis remplir.

# Domaines, sans https:// : leurs DNS doivent pointer vers le serveur.
SITE_DOMAIN=
ADMIN_DOMAIN=
# Domaine du jeu, par exemple jeu.changan-togo.tg
JEU_DOMAIN=

# Lettres et chiffres uniquement : il entre dans une URL de connexion.
POSTGRES_PASSWORD=

# Courriel de réinitialisation du mot de passe (sans lui, le lien n'est écrit que dans les journaux de l'API)
SMTP_URL=
SMTP_FROM=

# Stockage S3, facultatif. Vide : les médias vont dans le volume Docker « media ».
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Jeu en ligne : nombre d'instances du serveur, joueurs par instance et par salle (voir jeu/ARCHITECTURE.md)
JEU_INSTANCES=2
JEU_MAX_JOUEURS=1500
JEU_CAPACITE_SALLE=60
