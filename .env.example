# Base de données
DATABASE_URL=postgresql://changan@127.0.0.1:5544/changan

# API
API_PORT=3001
ADMIN_URL=http://localhost:3002
# true obligatoire en production (HTTPS)
COOKIE_SECURE=false
STORAGE_DIR=storage

# Stockage objet S3 compatible (laisser vide en développement : dossier local)
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Courriel de réinitialisation du mot de passe
SMTP_URL=
SMTP_FROM=

# Site public et administration
API_INTERNAL_URL=http://127.0.0.1:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
